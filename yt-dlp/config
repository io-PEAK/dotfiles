# ----------------------------
# Output Location
# ----------------------------

# Audio location
-o "[ext=m4a]/Users/peakmac/Music/Downloads/%(title)s.%(ext)s"

# Video location
-o "/Users/peakmac/Movies/YTDLP/%(title)s.%(ext)s"

# ----------------------------
# Default video format
# ----------------------------
-f "bv*+ba/b"
--merge-output-format mp4

# ----------------------------
# Default audio format
# ----------------------------
--audio-format m4a
--audio-quality 0

# ----------------------------
# Subtitles
# ----------------------------
--write-auto-subs
--sub-lang en
--convert-subs srt

# ----------------------------
# Stability
# ----------------------------
--extractor-args "youtube:player_client=android"
--console-title
--no-mtime
--newline
-c