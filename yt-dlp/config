# ----------------------------
# Output Location
# ----------------------------

# Audio location
-o "[ext=m4a]/Users/peakmac/Music/Downloads/%(title)s.%(ext)s"

# Video location
-o "/Users/peakmac/Movies/YTDLP/%(title)s.%(ext)s"

# ----------------------------
# Default video format
# ----------------------------
-f "bv*+ba/b"
--merge-output-format mp4

# ----------------------------
# Default audio format
# ----------------------------
--audio-format m4a
--audio-quality 0

# ----------------------------
# Subtitles
# ----------------------------
--write-auto-subs
--sub-langs "en.*"
--convert-subs srt

# ----------------------------
# Stability
# ----------------------------
--extractor-args "youtube:player_client=android"
--retries 10
--fragment-retries 10
--concurrent-fragments 4
--console-title
--no-mtime
--newline
-c

# ----------------------------
# Metadata & Thumbnails
# ----------------------------
--embed-metadata
--embed-thumbnail

# ----------------------------
# Gum Hooks
# ----------------------------
--exec "before_dl:command -v gum >/dev/null 2>&1 && gum style --foreground 212 --bold 'Starting download' || true"
--exec "after_move:command -v gum >/dev/null 2>&1 && gum style --foreground 42 Saved: %(filepath)q || true"