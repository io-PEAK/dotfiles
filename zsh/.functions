########################### COLOR SCRIPT #########################################

color() {                          
  emulate -L zsh
  setopt localoptions no_aliases

  if [[ $# -eq 0 ]]; then
    local choice

    choice=$(printf "%s\n" \
      "Random" \
      "List" \
      "Cancel" \
      "$(colorscript -l)" | gum choose --header $'Choose a colorscript pattern:\n' --show-help=false --padding "1 1") || return

    [[ "$choice" == "Cancel" ]] && return

    case "$choice" in
      "Random")
        command colorscript -r
        ;;
      "List")
        command colorscript -l
        ;;
      *)
        command colorscript -e "$choice"
        ;;
    esac
    return
  fi

  if [[ "$1" == "list" ]]; then   
    command colorscript -l                
        
  elif [[ "$1" == "random" ]]; then 
    command colorscript -r                
        
  else                              
    command colorscript -e "$1"            
  fi
}

tectonic() {
  emulate -L zsh
  setopt localoptions no_aliases

  local tectonic_bin
  if ! tectonic_bin="$(command -v tectonic 2>/dev/null)"; then
    gum style --foreground 196 "tectonic is not installed"
    return 127
  fi

  local -a tex_files
  tex_files=("${(@f)$(find . -maxdepth 2 -type f -name '*.tex' -print 2>/dev/null)}")
  tex_files=("${(@)tex_files:#}")

  local compile_one
  compile_one() {
    local file="$1"
    local binary="$2"

    [[ -n "$file" ]] || return 1
    [[ -f "$file" ]] || {
      gum style --foreground 196 "File not found: $file"
      return 1
    }

    local outdir pdf_path
    outdir="${file:h}"
    pdf_path="${file:r}.pdf"

    gum spin --spinner dot --title "Compiling ${file:t}..." -- \
      "$binary" --keep-logs --outdir "$outdir" "$file" >/dev/null 2>&1

    if [[ -f "$pdf_path" ]]; then
      gum style --foreground 42 "✓ PDF ready: $pdf_path"

      if command -v open >/dev/null 2>&1; then
        open "$pdf_path" >/dev/null 2>&1 &
      elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$pdf_path" >/dev/null 2>&1 &
      fi

      return 0
    fi

    gum style --foreground 196 "Compilation failed for: $file"
    return 1
  }

  if [[ $# -gt 0 ]]; then
    compile_one "$1" "$tectonic_bin"
    return $?
  fi

  if (( ${#tex_files} == 0 )); then
    local action
    action=$(printf '%s\n' \
      "Enter file path" \
      "Cancel" | gum choose \
      --header "No .tex files found in $(pwd)" \
      --height 10 \
      --padding "1 1" \
      --show-help=false) || return

    if [[ "$action" == "Cancel" ]]; then
      return 0
    fi

    echo
    local entered_file
    entered_file=$(gum input --placeholder "Path to .tex file") || return
    [[ -n "$entered_file" ]] || return 1

    compile_one "$entered_file" "$tectonic_bin"
    return $?
  fi

  local choice
  choice=$(printf '%s\n' "${tex_files[@]}" "Compile all" "Cancel" | gum choose \
    --header "Select a .tex file" \
    --height 14 \
    --padding "1 1" \
    --show-help=false) || return

  case "$choice" in
    "Cancel")
      return 0
      ;;
    "Compile all")
      local compiled_count=0
      local file
      for file in "${tex_files[@]}"; do
        if compile_one "$file" "$tectonic_bin"; then
          (( compiled_count += 1 ))
        fi
      done

      if (( compiled_count > 0 )); then
        gum style --foreground 42 "✓ Compiled $compiled_count PDF(s)"
        return 0
      fi
      return 1
      ;;
    *)
      compile_one "$choice" "$tectonic_bin"
      return $?
      ;;
  esac
}

########################### BATTERY INFORMATION ################################
batinfo() {

  while true; do
    clear

    data=$(gum spin --spinner dot --title "Fetching battery data..." -- \
    sleep 0.4
    ioreg -rn AppleSmartBattery | awk -F'= ' '
        /"CurrentCapacity"/ {curcap=$2}
        /"MaxCapacity"/ {maxcap=$2}
        /"AppleRawMaxCapacity"/ {rawmax=$2}
        /"DesignCapacity"/ {designcap=$2}
        /"CycleCount"/ {cycle=$2}
        /"Voltage"/ {volt=sprintf("%.2f", $2/1000)}
        /"ExternalConnected"/ {plug=$2}
        /"IsCharging"/ {charging=$2}
        /"FullyCharged"/ {full=$2}
        END {
            true_charge = (maxcap > 0) ? (curcap / maxcap) * 100 : 0
            health = (designcap > 0) ? (rawmax / designcap) * 100 : 0
            current_design_mah = (designcap > 0 && maxcap > 0) ? sprintf("%.0f", curcap * (designcap / maxcap)) : curcap

            printf "True Charge       : %.1f%% (raw)\n", true_charge
            printf "macOS Display %%   : %.1f%%\n", true_charge
            printf "Health (Max Cap)  : %.1f%%\n", health
            printf "Current Capacity  : %d mAh (of %d mAh)\n", current_design_mah, designcap
            printf "Full Capacity     : %d mAh\n", rawmax
            printf "Design (Native)   : %d mAh\n", designcap
            printf "Cycle Count       : %s\n", cycle
            printf "Voltage           : %s V\n", volt

            power = (plug == "Yes") ? "AC" : "Battery"
            printf "Power Source      : %s\n", power

            if (charging == "Yes") {
                charge_status = "Charging"
            } else if (plug == "Yes" && full == "Yes") {
                charge_status = "Bypass (100%)"
            } else {
                charge_status = "Not Charging"
            }
            printf "Charging          : %s\n", charge_status

            # print raw health separately for shell parsing
            printf "\n__HEALTH__=%.1f\n", health
        }')

    # extract health
    health=$(echo "$data" | grep "__HEALTH__" | cut -d= -f2)
    data=$(echo "$data" | grep -v "__HEALTH__")

    # show warning if needed
    if (( $(echo "$health < 80" | bc -l) )); then
      gum style --foreground 196 --bold "⚠️  Battery health is low ($health%)"
    fi

    # main UI block
    gum style \
  --border rounded \
  --padding "1 2" \
  --margin "1 0" \
  --border-foreground 212 \
  "$(printf "🔋 Battery Report\n\n%s" "$data")"

    # refresh loop
    gum confirm "Refresh battery info?" || break

  done
}
 
############################### git functions #######################################
clean_branch() {
  local branch="${1:-main}"
  local orphan_branch="clean-$branch"

  gum confirm "⚠️ This will DELETE history of '$branch'. Continue?" || return

  command git status
  echo "Ensure all work is committed and pushed."

  gum confirm "Proceed with cleaning branch '$branch'?" || return

  command git checkout --orphan "$orphan_branch"
  command git rm -rf .

  command git add .
  command git commit -m "chore: fresh start with up-to-date files"

  command git branch -D "$branch"
  command git branch -m "$branch"

  command git push --force origin "$branch"
  command git branch --set-upstream-to="origin/$branch" "$branch"

  gum style --foreground 42 "✅ Branch '$branch' reset successfully."
}

git() {
  emulate -L zsh
  setopt localoptions no_aliases

  if [[ $# -gt 0 ]]; then
    command git "$@"
    return
  fi

  if ! command -v gum >/dev/null 2>&1; then
    echo "gum not found. Running git help."
    command git --help
    return
  fi

  local action branch msg file_choice repo_name remote_name

  action=$(printf "%s\n" \
    "status" \
    "status --ignored" \
    "submodule status" \
    "add" \
    "commit" \
    "push" \
    "pull" \
    "pull --rebase" \
    "log" \
    "branch" \
    "switch branch" \
    "create branch" \
    "diff" \
    "diff --staged" \
    "restore" \
    "restore --staged" \
    "reset" \
    "stash" \
    "stash pop" \
    "undo last commit" \
    "create public repo" \
    "add ssh remote" \
    "Cancel" | gum choose --header $'Git Menu:\n' --show-help=false --padding "1 1") || return

  [[ "$action" == "Cancel" ]] && return

  case "$action" in
    "status")
      command git status
      ;;
    "status --ignored")
      command git status --ignored
      ;;
    "submodule status")
      command git submodule status
      ;;
    "add")
      echo
      file_choice=$(gum input --placeholder "File, folder, or . for all") || return
      [[ -z "$file_choice" ]] && return
      command git add "$file_choice"
      ;;
    "commit")
      echo
      msg=$(gum input --placeholder "Commit message") || return
      [[ -z "$msg" ]] && return
      command git commit -m "$msg"
      ;;
    "push")
      command git push
      ;;
    "pull")
      command git pull
      ;;
    "pull --rebase")
      command git pull --rebase
      ;;
    "log")
      command git log --oneline --graph --decorate
      ;;
    "branch")
      command git branch
      ;;
    "switch branch")
      branch=$(command git branch --format='%(refname:short)' | gum choose --header $'Switch to branch\n' --show-help=false --padding "1 1") || return
      [[ -z "$branch" ]] && return
      gum confirm "Switch to $branch?" && command git switch "$branch"
      ;;
    "create branch")
      echo
      branch=$(gum input --placeholder "New branch name") || return
      [[ -z "$branch" ]] && return
      command git switch -c "$branch"
      ;;
    "diff")
      command git diff
      ;;
    "diff --staged")
      command git diff --staged
      ;;
    "restore")
      echo
      file_choice=$(gum input --placeholder "File or folder to restore") || return
      [[ -z "$file_choice" ]] && return
      command git restore "$file_choice"
      ;;
    "restore --staged")
      echo
      file_choice=$(gum input --placeholder "File or folder to unstage") || return
      [[ -z "$file_choice" ]] && return
      command git restore --staged "$file_choice"
      ;;
    "reset")
      command git reset
      ;;
    "stash")
      command git stash
      ;;
    "stash pop")
      command git stash pop
      ;;
    "undo last commit")
      gum confirm "Undo last commit and keep changes?" && command git reset --soft HEAD~1
      ;;
    "create public repo")
      echo
      repo_name=$(gum input --placeholder "Repo name") || return
      [[ -z "$repo_name" ]] && return
      gum confirm "Create public repo '$repo_name'?" && \
        command gh repo create "$repo_name" --public --source=. --remote=origin 
      ;;
    "add ssh remote")
      echo
      remote_name=$(gum input --placeholder "Repo name") || return
      [[ -z "$remote_name" ]] && return
      gum confirm "Add remote '$remote_name'?" && \
        command git remote add origin git@github.com:io-PEAK/"$remote_name".git
      ;;
  esac
}

#################################### Spicetify Menu ####################################

spice() {
  emulate -L zsh
  setopt localoptions no_xtrace
  unsetopt xtrace
  set +x

  local theme_name="$1"
  local color_scheme="$2"

  # Get Spicetify's actual config directory
  local config_dir
  config_dir="$(spicetify config config_dir 2>/dev/null)"

  if [[ -z "$config_dir" || ! -d "$config_dir" ]]; then
    config_dir="$HOME/.config/spicetify"
  fi

  local themes_dir="$config_dir/Themes"

  # ─────────────────────────────────────────────
  # Interactive menu
  # ─────────────────────────────────────────────

  if [[ -z "$theme_name" ]]; then
    printf '\n'

    while true; do
      case "$(printf "%s\n" \
        "Choose Theme" \
        "Update Spicetify" \
        "Backup Apply" |
        gum choose \
          --show-help=false \
          --padding "1 1" \
          --header "Choose action (Esc to quit)")" in

        "Choose Theme")
          if [[ ! -d "$themes_dir" ]]; then
            gum style \
              --foreground 196 \
              "Themes directory not found: $themes_dir"
            return 1
          fi

          theme_name=$(
            ls -1 "$themes_dir" |
              gum choose \
                --show-help=false \
                --padding "1 1" \
                --header "Choose theme (Esc to go back)"
          ) || {
            printf '\033[1A\033[2K\r'
            continue
          }

          break
          ;;

        "Update Spicetify")
          theme_name="update"
          break
          ;;

        "Backup Apply")
          theme_name="backup-apply"
          break
          ;;

        "")
          printf '\033[1A\033[2K\r'
          return
          ;;
      esac
    done
  fi

  # ─────────────────────────────────────────────
  # Update Spicetify
  # ─────────────────────────────────────────────

  case "$theme_name" in
    update)
      gum confirm "Run 'spicetify update'?" || return

      if gum spin \
        --title "Updating Spicetify..." \
        -- spicetify update; then

        gum style \
          --foreground 42 \
          "🎵 Spicetify updated."
      else
        gum style \
          --foreground 196 \
          "❌ Spicetify update failed."
        return 1
      fi

      return
      ;;

    # ─────────────────────────────────────────
    # Backup Apply
    # ─────────────────────────────────────────

    backup-apply|backup_apply|backupapply)
      gum confirm "Run 'spicetify backup apply'?" || return

      if gum spin \
        --title "Running backup apply..." \
        -- spicetify backup apply; then

        gum style \
          --foreground 42 \
          "🎵 Spicetify backup apply completed."
      else
        gum style \
          --foreground 196 \
          "❌ Spicetify backup apply failed."
        return 1
      fi

      return
      ;;
  esac

  # ─────────────────────────────────────────────
  # Theme validation
  # ─────────────────────────────────────────────

  local theme_dir="$themes_dir/$theme_name"

  if [[ ! -d "$theme_dir" ]]; then
    gum style \
      --foreground 196 \
      "❌ Theme '$theme_name' not found."

    printf '\nThemes directory:\n%s\n' "$themes_dir"
    return 1
  fi

  # ─────────────────────────────────────────────
  # Color scheme validation
  # ─────────────────────────────────────────────

  if [[ -n "$color_scheme" ]]; then
    local color_file="$theme_dir/color.ini"

    if [[ ! -f "$color_file" ]]; then
      gum style \
        --foreground 196 \
        "❌ Theme '$theme_name' has no color.ini."
      return 1
    fi

    if ! grep -q "^\[$color_scheme\]" "$color_file"; then
      gum style \
        --foreground 196 \
        "❌ Invalid color scheme '$color_scheme'."

      printf '\nAvailable color schemes:\n'
      grep '^\[' "$color_file" | sed 's/^\[\(.*\)\]$/  \1/'

      return 1
    fi
  fi

  # ─────────────────────────────────────────────
  # Set theme
  # ─────────────────────────────────────────────

  if ! spicetify config current_theme "$theme_name"; then
    gum style \
      --foreground 196 \
      "❌ Failed to set theme."
    return 1
  fi

  # ─────────────────────────────────────────────
  # Set color scheme
  # ─────────────────────────────────────────────

  if [[ -n "$color_scheme" ]]; then
    if ! spicetify config color_scheme "$color_scheme"; then
      gum style \
        --foreground 196 \
        "❌ Failed to set color scheme."
      return 1
    fi
  fi

  # ─────────────────────────────────────────────
  # Apply
  # ─────────────────────────────────────────────

  if gum spin \
    --title "Applying '$theme_name'..." \
    -- spicetify apply; then

    gum style \
      --foreground 42 \
      "🎵 Theme '$theme_name' applied."
  else
    gum style \
      --foreground 196 \
      "❌ Failed to apply theme '$theme_name'."

    printf '\nRun this manually to see the full error:\n'
    printf '  spicetify apply\n'

    return 1
  fi
}

############################### Tig Menu ######################################################

tig() {
  emulate -L zsh
  setopt localoptions no_aliases

  if [[ $# -gt 0 ]]; then
    command tig "$@"
    return
  fi

  if ! command -v gum >/dev/null 2>&1; then
    command tig
    return
  fi

  local action theme base themes
  base="$HOME/.config/tig"
  themes="$base/themes"

  action=$(printf "%s\n" \
    "open tig" \
    "status" \
    "blame" \
    "show" \
    "all" \
    "theme" \
    "Cancel" | gum choose --header $'Tig Menu:\n' --show-help=false --padding "1 1") || return

  [[ "$action" == "Cancel" ]] && return

  case "$action" in
    "open tig")
      command tig
      ;;
    "status")
      command tig status
      ;;
    "blame")
      command tig blame
      ;;
    "show")
      command tig show
      ;;
    "all")
      command tig --all
      ;;
    "theme")
      theme=$(command ls "$themes" | gum choose --header $'Choose tig theme:\n' --show-help=false --padding "1 1") || return
      [[ -z "$theme" ]] && return
      if [[ ! -f "$themes/$theme" ]]; then
        gum style --foreground 196 "Theme not found"
        return 1
      fi

      ln -sf "$themes/$theme" "$base/theme.tig"
      command tig
      ;;
  esac
}

################################### Lazygit Menu #####################################

lazygit() {
  emulate -L zsh
  setopt localoptions no_aliases

  if [[ $# -gt 0 ]]; then
    command lazygit "$@"
    return
  fi

  if ! command -v gum >/dev/null 2>&1; then
    command lazygit
    return
  fi

  local action theme base themes base_config config theme_file repo_path config_file
  base="$HOME/github/dotfiles/lazygit"
  themes="$base/themes"
  base_config="$base/config.base.yml"
  config="$base/config.yml"

  action=$(printf "%s\n" \
    "open lazygit" \
    "open in repo path" \
    "open with config file" \
    "theme" \
    "Cancel" | gum choose --header $'Lazygit Menu:\n' --show-help=false --padding "1 1") || return

  [[ "$action" == "Cancel" ]] && return

  case "$action" in
    "open lazygit")
      command lazygit
      ;;
    "open in repo path")
      echo
      repo_path=$(gum input --placeholder "Repo path (example: ~/github/dotfiles)") || return
      [[ -z "$repo_path" ]] && return
      command lazygit -p "$repo_path"
      ;;
    "open with config file")
      echo
      config_file=$(gum input --placeholder "Config file path (example: ~/.config/lazygit/config.yml)") || return
      [[ -z "$config_file" ]] && return
      command lazygit -ucf "$config_file"
      ;;
    "theme")
      theme=$(command ls "$themes" | gum choose --header $'Choose lazygit theme:\n' --show-help=false --padding "1 1") || return
      [[ -z "$theme" ]] && return

      theme_file="$themes/$theme"
      if [[ ! -f "$theme_file" ]]; then
        gum style --foreground 196 "Theme not found"
        return 1
      fi

      gum spin --title "Applying lazygit theme..." -- \
        yq eval-all 'select(fileIndex == 0) * select(fileIndex == 1)' \
        "$base_config" "$theme_file" > "$config"

      command lazygit
      ;;
  esac
}
######################################## yt-dlp Menu ##########################################################

yt-dlp() {
  emulate -L zsh
  setopt localoptions no_aliases

  if [[ $# -gt 0 ]]; then
    command yt-dlp "$@"
    return
  fi

  if ! command -v gum >/dev/null 2>&1; then
    echo "gum not found. Running plain yt-dlp help."
    command yt-dlp --help
    return
  fi

  local action url quality format_selector sub_lang
  local start_ts end_ts section_expr format_id pstart pend

  action=$(printf "%s\n" \
    "Best video + audio" \
    "Download section (video)" \
    "Download section (audio m4a)" \
    "Audio only (m4a)" \
    "Audio only (mp3)" \
    "Custom format ID" \
    "List available formats" \
    "Media info (no download)" \
    "Subtitles only" \
    "Playlist (best)" \
    "Playlist range (best)" \
    "Cancel" | gum choose --header $'YT-dlp Menu:\n' --show-help=false --padding "1 1") || return

  [[ "$action" == "Cancel" ]] && return

  if [[ "$action" != "List available formats" ]]; then
    echo
    url=$(gum input --placeholder "Paste URL") || return
  else
    echo
    url=$(gum input --placeholder "Paste URL to inspect formats") || return
  fi

  [[ -z "$url" ]] && return

  case "$action" in
    "Best video + audio")
      quality=$(printf "%s\n" \
        "Best available" \
        "2160p" \
        "1440p" \
        "1080p" \
        "720p" \
        "480p" \
        "Cancel" | gum choose --header $'Choose quality\n' --show-help=false --padding "1 1") || return

      [[ "$quality" == "Cancel" ]] && return

      case "$quality" in
        "Best available") format_selector="bv*+ba/b" ;;
        "2160p") format_selector="bv*[height<=2160]+ba/b[height<=2160]" ;;
        "1440p") format_selector="bv*[height<=1440]+ba/b[height<=1440]" ;;
        "1080p") format_selector="bv*[height<=1080]+ba/b[height<=1080]" ;;
        "720p") format_selector="bv*[height<=720]+ba/b[height<=720]" ;;
        "480p") format_selector="bv*[height<=480]+ba/b[height<=480]" ;;
      esac

      gum style --foreground 212 "Mode: best video + audio"
      command yt-dlp -f "$format_selector" "$url"
      ;;
    "Download section (video)")
      quality=$(printf "%s\n" \
        "Best available" \
        "1080p" \
        "720p" \
        "480p" \
        "Cancel" | gum choose --header $'Choose quality\n' --show-help=false --padding "1 1") || return

      [[ "$quality" == "Cancel" ]] && return

      case "$quality" in
        "Best available") format_selector="bv*+ba/b" ;;
        "1080p") format_selector="bv*[height<=1080]+ba/b[height<=1080]" ;;
        "720p") format_selector="bv*[height<=720]+ba/b[height<=720]" ;;
        "480p") format_selector="bv*[height<=480]+ba/b[height<=480]" ;;
      esac

      echo
      start_ts=$(gum input --placeholder "Start time (optional, e.g. 00:01:30)") || return
      echo
      end_ts=$(gum input --placeholder "End time (optional, e.g. 00:03:40)") || return
      section_expr="*${start_ts}-${end_ts}"

      if [[ -z "$start_ts" && -z "$end_ts" ]]; then
        gum style --foreground 196 "Provide at least start or end time."
        return 1
      fi

      gum style --foreground 212 "Mode: section video (${section_expr})"
      command yt-dlp -f "$format_selector" --download-sections "$section_expr" --force-keyframes-at-cuts "$url"
      ;;
    "Download section (audio m4a)")
      echo
      start_ts=$(gum input --placeholder "Start time (optional, e.g. 00:01:30)") || return
      echo
      end_ts=$(gum input --placeholder "End time (optional, e.g. 00:03:40)") || return
      section_expr="*${start_ts}-${end_ts}"

      if [[ -z "$start_ts" && -z "$end_ts" ]]; then
        gum style --foreground 196 "Provide at least start or end time."
        return 1
      fi

      gum style --foreground 212 "Mode: section audio m4a (${section_expr})"
      command yt-dlp -x --audio-format m4a --download-sections "$section_expr" --force-keyframes-at-cuts "$url"
      ;;
    "Audio only (m4a)")
      gum style --foreground 212 "Mode: audio only (m4a)"
      command yt-dlp -x --audio-format m4a "$url"
      ;;
    "Audio only (mp3)")
      gum style --foreground 212 "Mode: audio only (mp3)"
      command yt-dlp -x --audio-format mp3 "$url"
      ;;
    "Custom format ID")
      echo
      format_id=$(gum input --placeholder "Format ID (example: 137+140 or 22)") || return
      [[ -z "$format_id" ]] && return
      gum style --foreground 212 "Mode: custom format ($format_id)"
      command yt-dlp -f "$format_id" "$url"
      ;;
    "List available formats")
      gum style --foreground 212 "Mode: list formats"
      command yt-dlp -F "$url"
      ;;
    "Media info (no download)")
      gum style --foreground 212 "Mode: media info"
      command yt-dlp --skip-download --print "title=%(title)s" --print "uploader=%(uploader)s" --print "duration=%(duration>%H:%M:%S)s" --print "view_count=%(view_count)s" --print "upload_date=%(upload_date)s" "$url"
      ;;
    "Subtitles only")
      sub_lang=$(printf "%s\n" \
        "en.*" \
        "all" \
        "es.*" \
        "fr.*" \
        "Cancel" | gum choose --header $'Choose subtitle language\n' --show-help=false --padding "1 1") || return

      [[ "$sub_lang" == "Cancel" ]] && return

      gum style --foreground 212 "Mode: subtitles only"
      command yt-dlp --skip-download --write-subs --write-auto-subs --sub-langs "$sub_lang" --convert-subs srt "$url"
      ;;
    "Playlist (best)")
      quality=$(printf "%s\n" \
        "Best available" \
        "1080p" \
        "720p" \
        "480p" \
        "Cancel" | gum choose --header $'Choose playlist quality\n' --show-help=false --padding "1 1") || return

      [[ "$quality" == "Cancel" ]] && return

      case "$quality" in
        "Best available") format_selector="bv*+ba/b" ;;
        "1080p") format_selector="bv*[height<=1080]+ba/b[height<=1080]" ;;
        "720p") format_selector="bv*[height<=720]+ba/b[height<=720]" ;;
        "480p") format_selector="bv*[height<=480]+ba/b[height<=480]" ;;
      esac

      gum style --foreground 212 "Mode: playlist (best)"
      command yt-dlp --yes-playlist -f "$format_selector" "$url"
      ;;
    "Playlist range (best)")
      quality=$(printf "%s\n" \
        "Best available" \
        "1080p" \
        "720p" \
        "480p" \
        "Cancel" | gum choose --header $'Choose playlist quality\n' --show-help=false --padding "1 1") || return

      [[ "$quality" == "Cancel" ]] && return

      case "$quality" in
        "Best available") format_selector="bv*+ba/b" ;;
        "1080p") format_selector="bv*[height<=1080]+ba/b[height<=1080]" ;;
        "720p") format_selector="bv*[height<=720]+ba/b[height<=720]" ;;
        "480p") format_selector="bv*[height<=480]+ba/b[height<=480]" ;;
      esac

      echo
      pstart=$(gum input --placeholder "Playlist start index (default: 1)") || return
      echo
      pend=$(gum input --placeholder "Playlist end index (optional)") || return
      [[ -z "$pstart" ]] && pstart=1

      gum style --foreground 212 "Mode: playlist range (${pstart}-${pend:-end})"
      if [[ -n "$pend" ]]; then
        command yt-dlp --yes-playlist --playlist-start "$pstart" --playlist-end "$pend" -f "$format_selector" "$url"
      else
        command yt-dlp --yes-playlist --playlist-start "$pstart" -f "$format_selector" "$url"
      fi
      ;;
  esac
}

########################### MAC SYSTEM CONFIGURE ################################

mac() {
  emulate -L zsh
  setopt localoptions no_aliases

  if ! command -v gum >/dev/null 2>&1; then
    echo "gum is required for this interactive menu."
    return 127
  fi

  local action choice choice2 speed delay loc format hours h_num seconds
  local -a main_menu kb_menu lid_menu gate_menu finder_menu screen_menu dock_menu timer_menu

  _pick() {
    local out rc
    out=$(gum choose "$@")
    rc=$?
    (( rc != 0 )) && printf '\033[1A\033[2K' >&2
    print -r -- "$out"
    return $rc
  }

  main_menu=(
    "Keyboard Speed (Fast Typing)"
    "Lid-Close Sleep Mode"
    "App Security (Gatekeeper)"
    "Desktop & Finder Visuals"
    "Screenshot Controls"
    "Dock & Window Tweaks"
    "Network Quick Fix"
    "Clear System Cache"
    "Exit"
  )

  while true; do
    action=$(print -l "${main_menu[@]}" | _pick --header "Mac Control Panel:" --show-help=false --padding "1 1") || return 0

    [[ "$action" == "Exit" || -z "$action" ]] && return 0

    case "$action" in
      "Keyboard Speed (Fast Typing)")
        kb_menu=("Make typing insanely fast" "Reset to Mac defaults" "<- Go Back")
        echo ""
        choice=$(print -l "${kb_menu[@]}" | _pick --header "Select Key Repeat Tuning:" --show-help=false) || continue
        [[ "$choice" == "<- Go Back" || -z "$choice" ]] && continue

        if [[ "$choice" == "Make typing insanely fast" ]]; then
          defaults write NSGlobalDomain KeyRepeat -int 1
          defaults write NSGlobalDomain InitialKeyRepeat -int 10
          gum style --foreground 42 "✅ Keyboard speed set to ultra-fast!"
        elif [[ "$choice" == "Reset to Mac defaults" ]]; then
          defaults write NSGlobalDomain KeyRepeat -int 2
          defaults write NSGlobalDomain InitialKeyRepeat -int 15
          gum style --foreground 42 "✅ Restored standard Mac keyboard limits."
        fi
        return 0
        ;;

      "Lid-Close Sleep Mode")
        lid_menu=("Keep awake when lid is closed" "Allow sleep on lid close (Default)" "<- Go Back")
        echo ""
        choice=$(print -l "${lid_menu[@]}" | _pick --header "Configure System Sleep:" --show-help=false) || continue
        [[ "$choice" == "<- Go Back" || -z "$choice" ]] && continue

        if [[ "$choice" == "Keep awake when lid is closed" ]]; then
          timer_menu=("Indefinitely (No Timer)" "1 Hour" "2 Hours" "4 Hours" "<- Go Back")
          echo ""
          hours=$(print -l "${timer_menu[@]}" | _pick --header "Set sleep prevention timeout?" --show-help=false) || continue
          [[ "$hours" == "<- Go Back" || -z "$hours" ]] && continue

          gum style --foreground 214 "🔑 Requires administrator password to alter sleep policies..."
          sudo pmset -a disablesleep 1

          if [[ "$hours" == "Indefinitely (No Timer)" ]]; then
            gum style --foreground 42 "✅ Sleep disabled indefinitely! Remember to turn it back off manually."
          else
            h_num=$(echo "$hours" | awk '{print $1}')
            seconds=$(( h_num * 3600 ))
            gum style --foreground 42 "✅ Sleep disabled for $hours. Re-enabling sleep in background..."

            (
              sleep "$seconds"
              sudo pmset -a disablesleep 0
              if command -v osascript >/dev/null 2>&1; then
                osascript -e 'display notification "Lid-close timeout complete. Standard sleep restored." with title "Mac System Config"'
              fi
            ) &!
          fi
          return 0

        elif [[ "$choice" == "Allow sleep on lid close (Default)" ]]; then
          gum style --foreground 214 "🔑 Requires administrator password..."
          sudo pmset -a disablesleep 0
          gum style --foreground 42 "✅ Standard closed-lid sleep restored immediately."
          return 0
        fi
        ;;

      "App Security (Gatekeeper)")
        gate_menu=("Allow apps downloaded from 'Anywhere'" "Enable standard Mac security" "<- Go Back")
        echo ""
        choice=$(print -l "${gate_menu[@]}" | _pick --header "Configure Security Rules:" --show-help=false) || continue
        [[ "$choice" == "<- Go Back" || -z "$choice" ]] && continue

        if [[ "$choice" == "Allow apps downloaded from 'Anywhere'" ]]; then
          gum style --foreground 196 --bold "⚠️ WARNING: This lowers security by letting unverified apps run."
          gum confirm "Are you sure you want to disable Gatekeeper restrictions?" --show-help=false || continue
          sudo spctl --master-disable
          gum style --foreground 42 "✅ Gatekeeper disabled."
        elif [[ "$choice" == "Enable standard Mac security" ]]; then
          sudo spctl --master-enable
          gum style --foreground 42 "✅ Gatekeeper re-enabled."
        fi
        return 0
        ;;

      "Desktop & Finder Visuals")
        finder_menu=("Hide all Desktop Icons" "Show all Desktop Icons" "Show hidden files in Finder" "Hide hidden files in Finder" "<- Go Back")
        echo ""
        choice=$(print -l "${finder_menu[@]}" | _pick --header "Finder Tweak Settings:" --show-help=false) || continue
        [[ "$choice" == "<- Go Back" || -z "$choice" ]] && continue

        case "$choice" in
          "Hide all Desktop Icons")
            defaults write com.apple.finder CreateDesktop false && killall Finder
            gum style --foreground 42 "✅ Desktop icons hidden!"
            ;;
          "Show all Desktop Icons")
            defaults write com.apple.finder CreateDesktop true && killall Finder
            gum style --foreground 42 "✅ Desktop icons restored."
            ;;
          "Show hidden files in Finder")
            defaults write com.apple.finder AppleShowAllFiles true && killall Finder
            gum style --foreground 42 "✅ Hidden system files revealed."
            ;;
          "Hide hidden files in Finder")
            defaults write com.apple.finder AppleShowAllFiles false && killall Finder
            gum style --foreground 42 "✅ Hidden files tucked away."
            ;;
        esac
        return 0
        ;;

      "Screenshot Controls")
        screen_menu=("Change target folder destination" "Change file format type" "<- Go Back")
        echo ""
        choice=$(print -l "${screen_menu[@]}" | _pick --header "Screenshot Tweaks:" --show-help=false) || continue
        [[ "$choice" == "<- Go Back" || -z "$choice" ]] && continue

        if [[ "$choice" == "Change target folder destination" ]]; then
          echo ""
          loc=$(printf "%s\n" "Desktop" "Downloads" "<- Go Back" | _pick --header "Choose target folder:" --show-help=false) || continue
          [[ "$loc" == "<- Go Back" || -z "$loc" ]] && continue
          defaults write com.apple.screencapture location ~/"$loc" && killall SystemUIServer
          gum style --foreground 42 "✅ Screenshots will save to $loc."
        elif [[ "$choice" == "Change file format type" ]]; then
          echo ""
          format=$(printf "%s\n" "png" "jpg" "<- Go Back" | _pick --header "Choose file format:" --show-help=false) || continue
          [[ "$format" == "<- Go Back" || -z "$format" ]] && continue
          defaults write com.apple.screencapture type "$format" && killall SystemUIServer
          gum style --foreground 42 "✅ Output changed to $format."
        fi
        return 0
        ;;

      "Dock & Window Tweaks")
        dock_menu=("Make Dock appear instantly" "Reset Dock animation" "Disable wallpaper-click gesture" "Enable wallpaper-click gesture" "<- Go Back")
        echo ""
        choice=$(print -l "${dock_menu[@]}" | _pick --header "Interface Customisations:" --show-help=false) || continue
        [[ "$choice" == "<- Go Back" || -z "$choice" ]] && continue

        case "$choice" in
          "Make Dock appear instantly")
            defaults write com.apple.dock autohide-delay -float 0
            defaults write com.apple.dock autohide-time-modifier -float 0 && killall Dock
            gum style --foreground 42 "✅ Dock speed maximized!"
            ;;
          "Reset Dock animation")
            defaults delete com.apple.dock autohide-delay
            defaults delete com.apple.dock autohide-time-modifier && killall Dock
            gum style --foreground 42 "✅ Dock animation reset."
            ;;
          "Disable wallpaper-click gesture")
            defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false
            gum style --foreground 42 "✅ Wallpaper-click disabled."
            ;;
          "Enable wallpaper-click gesture")
            defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool true
            gum style --foreground 42 "✅ Wallpaper-click enabled."
            ;;
        esac
        return 0
        ;;

      "Network Quick Fix")
        gum confirm "⚡ Flush DNS cache and bounce your Wi-Fi interface?" --show-help=false || continue
        gum spin --spinner dot --title "Resetting local network adapters..." -- \
          bash -c "sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder; networksetup -setairportpower en0 off; sleep 1; networksetup -setairportpower en0 on"
        gum style --foreground 42 "✅ Network stack refreshed!"
        return 0
        ;;

      "Clear System Cache")
        gum confirm "⚠️ Free up disk space by clearing user cache files?" --show-help=false || continue
        gum spin --spinner dot --title "Purging logs and system temporary caches..." -- \
          rm -rf ~/Library/Caches/*
        gum style --foreground 42 "✅ Caches cleaned successfully!"
        return 0
        ;;
    esac
  done
}

########################### MAC STORAGE CLEANUP ################################

diskclean() {
  emulate -L zsh
  setopt localoptions no_aliases

  if ! command -v gum >/dev/null 2>&1; then
    echo "gum is required for this interactive menu."
    return 127
  fi

  # label -> shell command (as a string, run via eval)
  local -A targets
  targets=(
    "npm cache (safe, re-downloads on next install)"            "npm cache clean --force"
    "pip cache (safe, re-downloads on next install)"            "pip cache purge"
    "Homebrew old versions + cache (brew cleanup -s)"           "brew cleanup -s"
    "Docker prune - images + build cache (keeps volumes/data)"  "docker system prune -a -f"
    "Claude Desktop VM bundles (re-downloads if needed)"        "rm -rf \"\$HOME/Library/Application Support/Claude/vm_bundles\""
    "Claude Desktop app cache"                                  "rm -rf \"\$HOME/Library/Application Support/Claude/Cache\" \"\$HOME/Library/Application Support/Claude/Code Cache\""
    "Brave browser cache (quit Brave first)"                    "rm -rf \"\$HOME/Library/Caches/BraveSoftware\""
    "Zen browser cache (quit Zen first)"                        "rm -rf \"\$HOME/Library/Caches/zen\""
    "Spotify cache"                                             "rm -rf \"\$HOME/Library/Caches/com.spotify.client\""
    "Playwright browser binaries cache (re-downloads on use)"   "rm -rf \"\$HOME/Library/Caches/ms-playwright\" \"\$HOME/Library/Caches/ms-playwright-go\""
    "Xcode DerivedData"                                         "rm -rf \"\$HOME/Library/Developer/Xcode/DerivedData\""
    "Xcode unavailable simulators"                              "xcrun simctl delete unavailable"
    "Old logs (>30 days, ~/Library/Logs)"                       "find \"\$HOME/Library/Logs\" -type f -mtime +30 -delete"
    "Empty Trash"                                                "rm -rf \"\$HOME/.Trash\"/* \"\$HOME/.Trash\"/.*  2>/dev/null"
    "Time Machine local snapshots (frees space immediately)"    "sudo tmutil thinlocalsnapshots / 999999999999 4"
  )

  # stable order for display
  local -a labels
  labels=(
    "npm cache (safe, re-downloads on next install)"
    "pip cache (safe, re-downloads on next install)"
    "Homebrew old versions + cache (brew cleanup -s)"
    "Docker prune - images + build cache (keeps volumes/data)"
    "Claude Desktop VM bundles (re-downloads if needed)"
    "Claude Desktop app cache"
    "Brave browser cache (quit Brave first)"
    "Zen browser cache (quit Zen first)"
    "Spotify cache"
    "Playwright browser binaries cache (re-downloads on use)"
    "Xcode DerivedData"
    "Xcode unavailable simulators"
    "Old logs (>30 days, ~/Library/Logs)"
    "Empty Trash"
    "Time Machine local snapshots (frees space immediately)"
  )

  gum style --foreground 212 --bold "🧹 Mac Storage Cleanup"
  echo ""

  local -a chosen
  chosen=("${(@f)$(print -l "${labels[@]}" | gum choose --no-limit \
    --header $'Select what to clean (space to toggle, enter to confirm):\n' \
    --height 20 --show-help=false --padding "1 1")}")

  if (( ${#chosen} == 0 )); then
    gum style --foreground 214 "Nothing selected. Exiting."
    return 0
  fi

  echo ""
  gum style --foreground 250 "Selected ${#chosen} item(s):"
  local item
  for item in "${chosen[@]}"; do
    gum style --foreground 250 "  • $item"
  done
  echo ""

  gum confirm "Proceed with cleanup?" --show-help=false || { gum style --foreground 214 "Cancelled."; return 0; }

  local before after freed
  before=$(df -k /System/Volumes/Data | awk 'NR==2{print $3}')

  echo ""
  for item in "${chosen[@]}"; do
    local cmd="${targets[$item]}"
    [[ -z "$cmd" ]] && continue

    gum spin --spinner dot --title "Cleaning: $item" -- zsh -c "$cmd" 2>/dev/null
    gum style --foreground 42 "✓ $item"
  done

  after=$(df -k /System/Volumes/Data | awk 'NR==2{print $3}')
  freed=$(( (before - after) / 1024 ))

  echo ""
  if (( freed > 0 )); then
    gum style --border rounded --padding "1 2" --border-foreground 42 \
      "✅ Cleanup complete. Freed approximately ${freed} MB."
  else
    gum style --border rounded --padding "1 2" --border-foreground 214 \
      "Cleanup ran. Disk usage may take a moment (or a reboot) to reflect fully."
  fi

  gum style --foreground 245 "Tip: run 'diskwhat' anytime to see what's actually using space."
}

########################### MAC STORAGE INSPECTOR ################################

diskwhat() {
  emulate -L zsh
  setopt localoptions no_aliases

  if ! command -v gum >/dev/null 2>&1; then
    echo "gum is required for this interactive menu."
    return 127
  fi

  local -a menu
  menu=(
    "Real total disk usage (the number that actually matters)"
    "~/Library breakdown (top-level)"
    "~/Library/Application Support breakdown"
    "~/Library/Caches breakdown"
    "~/Library/Containers breakdown"
    "~/Library/Group Containers breakdown"
    "Home folder top-level (~)"
    "Downloads folder"
    "Documents folder"
    "Docker disk usage"
    "Time Machine local snapshots"
    "Biggest files in home folder (>500MB)"
    "Exit"
  )

  while true; do
    echo ""
    local choice
    choice=$(print -l "${menu[@]}" | gum choose \
      --header $'What do you want to check?\n' \
      --height 15 --show-help=false --padding "1 1") || return 0

    [[ "$choice" == "Exit" || -z "$choice" ]] && return 0

    echo ""
    case "$choice" in
      "Real total disk usage (the number that actually matters)")
        gum style --foreground 212 --bold "Real disk usage (ignore the Storage panel's 'System Data' number):"
        df -h /System/Volumes/Data
        ;;

      "~/Library breakdown (top-level)")
        gum spin --spinner dot --title "Scanning ~/Library..." -- sleep 0.3
        du -sh "$HOME"/Library/*/ 2>/dev/null | sort -rh | head -20
        ;;

      "~/Library/Application Support breakdown")
        gum spin --spinner dot --title "Scanning Application Support..." -- sleep 0.3
        du -sh "$HOME/Library/Application Support"/*/ 2>/dev/null | sort -rh | head -20
        ;;

      "~/Library/Caches breakdown")
        gum spin --spinner dot --title "Scanning Caches..." -- sleep 0.3
        du -sh "$HOME/Library/Caches"/*/ 2>/dev/null | sort -rh | head -20
        ;;

      "~/Library/Containers breakdown")
        gum spin --spinner dot --title "Scanning Containers..." -- sleep 0.3
        du -sh "$HOME/Library/Containers"/*/ 2>/dev/null | sort -rh | head -20
        ;;

      "~/Library/Group Containers breakdown")
        gum spin --spinner dot --title "Scanning Group Containers..." -- sleep 0.3
        du -sh "$HOME/Library/Group Containers"/*/ 2>/dev/null | sort -rh | head -20
        ;;

      "Home folder top-level (~)")
        gum spin --spinner dot --title "Scanning home folder..." -- sleep 0.3
        du -sh "$HOME"/*/ 2>/dev/null | sort -rh | head -20
        ;;

      "Downloads folder")
        gum spin --spinner dot --title "Scanning Downloads..." -- sleep 0.3
        du -sh "$HOME/Downloads"/*/ 2>/dev/null | sort -rh | head -20
        du -sh "$HOME/Downloads"/* 2>/dev/null | sort -rh | head -20
        ;;

      "Documents folder")
        gum spin --spinner dot --title "Scanning Documents..." -- sleep 0.3
        du -sh "$HOME/Documents"/*/ 2>/dev/null | sort -rh | head -20
        ;;

      "Docker disk usage")
        if command -v docker >/dev/null 2>&1; then
          docker system df
        else
          gum style --foreground 196 "Docker not found."
        fi
        ;;

      "Time Machine local snapshots")
        tmutil listlocalsnapshots / 2>/dev/null
        ;;

      "Biggest files in home folder (>500MB)")
        gum style --foreground 214 "This can take a minute..."
        gum spin --spinner dot --title "Searching for large files..." -- \
          find "$HOME" -type f -size +500M 2>/dev/null > /tmp/diskwhat_bigfiles.txt
        if [[ -s /tmp/diskwhat_bigfiles.txt ]]; then
          while IFS= read -r f; do
            du -h "$f" 2>/dev/null
          done < /tmp/diskwhat_bigfiles.txt | sort -rh
        else
          gum style --foreground 42 "No files over 500MB found."
        fi
        rm -f /tmp/diskwhat_bigfiles.txt
        ;;
    esac

    echo ""
    gum confirm "Check something else?" --show-help=false || return 0
  done
}

############################ FFMPEG TOOLS #################################

ffmpeg() {
  emulate -L zsh
  setopt localoptions no_aliases

  if ! command -v gum >/dev/null 2>&1; then
    echo "gum is required for this interactive menu."
    return 127
  fi

  if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "ffmpeg is required. Install it with: brew install ffmpeg"
    return 127
  fi

  if ! command -v ffprobe >/dev/null 2>&1; then
    echo "ffprobe is required. It normally comes with FFmpeg."
    return 127
  fi

  local action choice input output format quality width start duration audio
  local -a main_menu

  _pick() {
    local out rc
    out=$(gum choose "$@")
    rc=$?
    (( rc != 0 )) && printf '\033[1A\033[2K' >&2
    print -r -- "$out"
    return $rc
  }

  _file_exists() {
    if [[ ! -f "$1" ]]; then
      gum style --foreground 196 "❌ File not found: $1"
      return 1
    fi
    return 0
  }

  main_menu=(
    "Convert Video"
    "Compress Video"
    "Trim Video"
    "Resize Video"
    "Convert Audio"
    "Extract Audio"
    "Remove Audio"
    "Extract Frames"
    "Create GIF"
    "Merge Audio + Video"
    "Inspect Media"
    "Exit"
  )

  while true; do
    action=$(print -l "${main_menu[@]}" | _pick \
      --header "FFmpeg Control Panel:" \
      --show-help=false \
      --padding "1 1") || return 0

    [[ "$action" == "Exit" || -z "$action" ]] && return 0

    case "$action" in

      # ---------------------------------------------------------
      # CONVERT VIDEO
      # ---------------------------------------------------------
      "Convert Video")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        format=$(printf "%s\n" "mp4" "mkv" "webm" "mov" | \
          _pick --header "Choose output format:" --show-help=false) || continue

        [[ -z "$format" ]] && continue

        output="${input%.*}.$format"

        gum style --foreground 214 \
          "🎬 Converting $input → $output"

        ffmpeg -i "$input" "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Conversion complete!"
        else
          gum style --foreground 196 "❌ Conversion failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # COMPRESS VIDEO
      # ---------------------------------------------------------
      "Compress Video")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        quality=$(printf "%s\n" \
          "High Quality (CRF 20)" \
          "Balanced (CRF 23)" \
          "Smaller File (CRF 28)" \
          "<- Go Back" | \
          _pick --header "Choose compression level:" --show-help=false) || continue

        [[ "$quality" == "<- Go Back" || -z "$quality" ]] && continue

        case "$quality" in
          "High Quality (CRF 20)")
            quality=20
            ;;
          "Balanced (CRF 23)")
            quality=23
            ;;
          "Smaller File (CRF 28)")
            quality=28
            ;;
        esac

        output="${input%.*}-compressed.mp4"

        gum style --foreground 214 \
          "📦 Compressing video..."

        ffmpeg -i "$input" \
          -c:v libx264 \
          -crf "$quality" \
          -preset medium \
          -c:a aac \
          -b:a 128k \
          "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Compressed video: $output"
        else
          gum style --foreground 196 "❌ Compression failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # TRIM VIDEO
      # ---------------------------------------------------------
      "Trim Video")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        start=$(gum input \
          --prompt "Start time (HH:MM:SS): " \
          --value "00:00:00")

        duration=$(gum input \
          --prompt "Duration (HH:MM:SS): " \
          --value "00:00:10")

        [[ -z "$start" || -z "$duration" ]] && continue

        output="${input%.*}-trimmed.mp4"

        gum style --foreground 214 "✂️ Cutting video..."

        ffmpeg \
          -ss "$start" \
          -i "$input" \
          -t "$duration" \
          -c:v libx264 \
          -c:a aac \
          "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Trimmed video: $output"
        else
          gum style --foreground 196 "❌ Trimming failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # RESIZE VIDEO
      # ---------------------------------------------------------
      "Resize Video")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        width=$(printf "%s\n" \
          "3840 (4K)" \
          "1920 (1080p)" \
          "1280 (720p)" \
          "854 (480p)" \
          "<- Go Back" | \
          _pick --header "Choose video width:" --show-help=false) || continue

        [[ "$width" == "<- Go Back" || -z "$width" ]] && continue

        width="${width%% *}"

        output="${input%.*}-${width}p.mp4"

        gum style --foreground 214 "📐 Resizing video..."

        ffmpeg -i "$input" \
          -vf "scale=${width}:-2" \
          -c:v libx264 \
          -crf 23 \
          -c:a aac \
          "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Resized video: $output"
        else
          gum style --foreground 196 "❌ Resize failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # CONVERT AUDIO
      # ---------------------------------------------------------
      "Convert Audio")
        echo ""
        input=$(gum input --prompt "Input audio: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        format=$(printf "%s\n" "mp3" "wav" "flac" "m4a" | \
          _pick --header "Choose output format:" --show-help=false) || continue

        [[ -z "$format" ]] && continue

        output="${input%.*}.$format"

        gum style --foreground 214 \
          "🎵 Converting $input → $output"

        ffmpeg -i "$input" "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Conversion complete!"
        else
          gum style --foreground 196 "❌ Conversion failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # EXTRACT AUDIO
      # ---------------------------------------------------------
      "Extract Audio")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        format=$(printf "%s\n" "mp3" "m4a" "wav" "flac" | \
          _pick --header "Choose audio format:" --show-help=false) || continue

        [[ -z "$format" ]] && continue

        output="${input%.*}.$format"

        gum style --foreground 214 "🎵 Extracting audio..."

        case "$format" in
          mp3)
            ffmpeg -i "$input" -vn -c:a libmp3lame -q:a 2 "$output"
            ;;
          m4a)
            ffmpeg -i "$input" -vn -c:a aac -b:a 192k "$output"
            ;;
          wav)
            ffmpeg -i "$input" -vn "$output"
            ;;
          flac)
            ffmpeg -i "$input" -vn -c:a flac "$output"
            ;;
        esac

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Audio extracted: $output"
        else
          gum style --foreground 196 "❌ Audio extraction failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # REMOVE AUDIO
      # ---------------------------------------------------------
      "Remove Audio")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        output="${input%.*}-silent.mp4"

        gum style --foreground 214 "🔇 Removing audio..."

        ffmpeg -i "$input" -c:v copy -an "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Silent video created: $output"
        else
          gum style --foreground 196 "❌ Operation failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # EXTRACT FRAMES
      # ---------------------------------------------------------
      "Extract Frames")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        choice=$(printf "%s\n" \
          "1 frame per second" \
          "1 frame every 5 seconds" \
          "10 frames per second" \
          "<- Go Back" | \
          _pick --header "Frame extraction rate:" --show-help=false) || continue

        [[ "$choice" == "<- Go Back" || -z "$choice" ]] && continue

        case "$choice" in
          "1 frame per second")
            speed=1
            ;;
          "1 frame every 5 seconds")
            speed="1/5"
            ;;
          "10 frames per second")
            speed=10
            ;;
        esac

        local frame_dir="${input%.*}-frames"
        mkdir -p "$frame_dir"

        gum style --foreground 214 "🖼️ Extracting frames..."

        ffmpeg -i "$input" \
          -vf "fps=$speed" \
          "$frame_dir/frame-%04d.jpg"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 \
            "✅ Frames saved to: $frame_dir/"
        else
          gum style --foreground 196 "❌ Frame extraction failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # CREATE GIF
      # ---------------------------------------------------------
      "Create GIF")
        echo ""
        input=$(gum input --prompt "Input video: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        start=$(gum input \
          --prompt "Start time (HH:MM:SS): " \
          --value "00:00:00")

        duration=$(gum input \
          --prompt "Duration: " \
          --value "00:00:05")

        [[ -z "$start" || -z "$duration" ]] && continue

        output="${input%.*}.gif"

        gum style --foreground 214 "🎞️ Creating GIF..."

        ffmpeg \
          -ss "$start" \
          -t "$duration" \
          -i "$input" \
          -vf "fps=10,scale=720:-1:flags=lanczos" \
          "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ GIF created: $output"
        else
          gum style --foreground 196 "❌ GIF creation failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # MERGE AUDIO + VIDEO
      # ---------------------------------------------------------
      "Merge Audio + Video")
        echo ""
        input=$(gum input --prompt "Video file: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        audio=$(gum input --prompt "Audio file: ")
        [[ -z "$audio" ]] && continue
        _file_exists "$audio" || continue

        output="${input%.*}-merged.mp4"

        gum style --foreground 214 \
          "🔀 Combining video + audio..."

        ffmpeg \
          -i "$input" \
          -i "$audio" \
          -map 0:v:0 \
          -map 1:a:0 \
          -c:v copy \
          -c:a aac \
          -shortest \
          "$output"

        if [[ $? -eq 0 ]]; then
          gum style --foreground 42 "✅ Merged file: $output"
        else
          gum style --foreground 196 "❌ Merge failed."
        fi

        return 0
        ;;


      # ---------------------------------------------------------
      # INSPECT MEDIA
      # ---------------------------------------------------------
      "Inspect Media")
        echo ""
        input=$(gum input --prompt "Media file: ")
        [[ -z "$input" ]] && continue
        _file_exists "$input" || continue

        echo ""
        gum style --foreground 214 "🔍 Media information:"
        echo ""

        ffprobe \
          -hide_banner \
          -v error \
          -show_entries \
          format=filename,duration,size,format_name:stream=index,codec_name,codec_type,width,height,r_frame_rate \
          -of default=noprint_wrappers=1 \
          "$input"

        echo ""
        gum style --foreground 42 "✅ Inspection complete."

        return 0
        ;;

    esac
  done
}

