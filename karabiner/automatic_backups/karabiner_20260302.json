{
  "profiles": [
    {
      "name": "Modal",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Hyper + Modal App Launcher",
            "manipulators": [
              {
                "_comment": "Caps -> Hyper (hold) / Escape (tap)",
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "key_code": "left_shift",
                    "modifiers": ["left_command", "left_control", "left_option"]
                  }
                ],
                "to_if_alone": [{ "key_code": "escape" }],
                "parameters": {
                  "basic.to_if_alone_timeout_milliseconds": 500,
                  "basic.to_delayed_action_delay_milliseconds": 500
                }
              },
              {
                "_comment": "Enter Dev Mode (Hyper + d)",
                "type": "basic",
                "from": {
                  "key_code": "d",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "set_variable": { "name": "app_mode", "value": 1 } }]
              },
              {
                "_comment": "Dev mode: t -> Ghostty",
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "app_mode", "value": 1 }],
                "from": { "key_code": "t", "modifiers": { "optional": ["any"] } },
                "to": [
                  { "shell_command": "open -b com.mitchellh.ghostty" },
                  { "set_variable": { "name": "app_mode", "value": 0 } }
                ]
              },
              {
                "_comment": "Dev mode: v -> VS Code",
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "app_mode", "value": 1 }],
                "from": { "key_code": "v", "modifiers": { "optional": ["any"] } },
                "to": [
                  { "shell_command": "open -b com.microsoft.VSCode" },
                  { "set_variable": { "name": "app_mode", "value": 0 } }
                ]
              },
              {
                "_comment": "Dev mode: escape to cancel",
                "type": "basic",
                "conditions": [{ "type": "variable_if", "name": "app_mode", "value": 1 }],
                "from": { "key_code": "escape", "modifiers": { "optional": ["any"] } },
                "to": [{ "set_variable": { "name": "app_mode", "value": 0 } }]
              },
              {
                "_comment": "Hyper + h -> Left Arrow",
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "left_arrow" }]
              },
              {
                "_comment": "Hyper + j -> Down Arrow",
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "down_arrow" }]
              },
              {
                "_comment": "Hyper + k -> Up Arrow",
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "up_arrow" }]
              },
              {
                "_comment": "Hyper + l -> Right Arrow",
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "right_arrow" }]
              },
              {
                "_comment": "Hyper + a -> Cmd+A (Select All)",
                "type": "basic",
                "from": {
                  "key_code": "a",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "a", "modifiers": ["left_command"] }]
              },
              {
                "_comment": "Hyper + c -> Cmd+C (Copy)",
                "type": "basic",
                "from": {
                  "key_code": "c",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "c", "modifiers": ["left_command"] }]
              },
              {
                "_comment": "Hyper + v -> Cmd+V (Paste)",
                "type": "basic",
                "from": {
                  "key_code": "v",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "v", "modifiers": ["left_command"] }]
              },
              {
                "_comment": "Hyper + w -> Cmd+W (Close Tab)",
                "type": "basic",
                "from": {
                  "key_code": "w",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "w", "modifiers": ["left_command"] }]
              },
              {
                "_comment": "Hyper + b -> Cmd+B (Bold)",
                "type": "basic",
                "from": {
                  "key_code": "b",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_command", "left_control", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "key_code": "b", "modifiers": ["left_command"] }]
              }
            ]
          }
        ]
      }
    }
  ]
}
